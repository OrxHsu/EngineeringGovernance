{
  "name": "@xgh/engineering-governance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "bin": {
    "sop": "dist/cli/main.js"
  },
  "files": [
    "adapters",
    "dist",
    "schemas",
    "skills/delivery-sop",
    "templates",
    "CORE_INVARIANTS.md",
    "DEVELOPMENT_SOP.md",
    "RISK_CLASSIFICATION.md",
    "VERSION"
  ],
  "bundleDependencies": [
    "ajv",
    "commander",
    "yaml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle:runner": "node scripts/build-runner-bundle.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "sop": "tsx src/cli/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm check:placeholders && pnpm check:licenses"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "commander": "14.0.0",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "22.17.0",
    "tsx": "4.20.3",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
