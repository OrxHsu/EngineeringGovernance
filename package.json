{
  "name": "@xgh/engineering-governance",
  "version": "2.1.0",
  "private": false,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "bin": {
    "sop": "dist/cli/main.js"
  },
  "files": [
    "adapters",
    "dist",
    "src",
    "schemas",
    "skills/delivery-sop",
    "templates",
    "scripts/build-runner-bundle.mjs",
    "CORE_INVARIANTS.md",
    "DEVELOPMENT_SOP.md",
    "MIGRATING_TO_2.0.md",
    "RISK_CLASSIFICATION.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md",
    "CHANGELOG.md",
    "VERSION"
  ],
  "bundleDependencies": [
    "ajv",
    "commander",
    "yaml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle:runner": "node scripts/build-runner-bundle.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "check:governance-docs": "node scripts/check-governance-docs.mjs",
    "sop": "tsx src/cli/main.ts",
    "test": "pnpm build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm check:placeholders && pnpm check:licenses"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "commander": "14.0.0",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "22.17.0",
    "tsx": "4.20.3",
    "typescript": "7.0.2",
    "vitest": "3.2.4"
  }
}
