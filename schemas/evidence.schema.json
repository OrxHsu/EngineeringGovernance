{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-governance.local/schemas/evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "contractDigest", "runId", "implementationCommits", "records", "summary"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "contractDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "runId": { "type": "string", "minLength": 1 },
    "implementationCommits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "commit", "tree"],
        "properties": {
          "repository": { "type": "string", "minLength": 1 },
          "commit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
          "tree": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" }
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["acceptanceId", "executedCheckIds", "command", "exitCode", "startedAt", "endedAt", "evidenceKind", "implementationIdentities", "rawArtifact", "observation"],
        "properties": {
          "acceptanceId": { "type": "string", "minLength": 1 },
          "executedCheckIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "command": { "type": "string", "minLength": 1 },
          "exitCode": { "type": "integer" },
          "startedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$" },
          "endedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$" },
          "evidenceKind": { "enum": ["static", "compile", "unit", "integration", "device", "cloud", "production"] },
          "implementationIdentities": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" } },
          "rawArtifact": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          },
          "observation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passedIds", "failedIds"],
      "properties": {
        "passedIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "failedIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
