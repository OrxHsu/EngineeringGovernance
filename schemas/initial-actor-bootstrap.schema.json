{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-governance.local/schemas/initial-actor-bootstrap.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "bootstrapId", "authorizationId", "projectRoot", "policyDigest", "grantor", "issuedAt", "expiresAt", "status", "actors"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactType": { "const": "engineering-governance-initial-actor-bootstrap-v1" },
    "bootstrapId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "authorizationId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "projectRoot": { "type": "string", "pattern": "^/", "minLength": 2 },
    "policyDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "grantor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "trustLevel"],
      "properties": {
        "id": { "const": "user-authority" },
        "role": { "const": "user" },
        "trustLevel": { "const": "local-claim" }
      }
    },
    "issuedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$" },
    "expiresAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$" },
    "status": { "const": "approved" },
    "actors": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actorId", "aliases", "role"],
        "properties": {
          "actorId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "aliases": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" } },
          "role": { "enum": ["contract-author", "implementation-owner", "contract-reviewer", "implementation-reviewer", "supervisor"] }
        }
      }
    }
  }
}
