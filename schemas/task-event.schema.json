{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-governance.local/schemas/task-event.schema.json",
  "$defs": {
    "state": { "enum": ["DEFINED", "IN_PROGRESS", "CANDIDATE", "ACCEPTED", "CLOSED", "REPAIR_REQUIRED", "BLOCKED", "CANCELLED", "SUPERSEDED"] }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sequence", "previousEventDigest", "from", "to", "actorId", "contractDigest", "artifactRefs", "eventDigest"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "sequence": { "type": "integer", "minimum": 1 },
    "previousEventDigest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "from": { "oneOf": [{ "$ref": "#/$defs/state" }, { "type": "null" }] },
    "to": { "$ref": "#/$defs/state" },
    "actorId": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$" },
    "contractDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "eventDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
