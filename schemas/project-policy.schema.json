{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-governance.local/schemas/project-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sopVersion", "sopDigest", "projectId", "adapters", "artifactMapping"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sopVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "sopDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "projectId": { "type": "string", "minLength": 1 },
    "minimumSupportedVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool", "source", "targets", "digest"],
        "properties": {
          "tool": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "targets": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "artifactMapping": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "path", "sha256"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
