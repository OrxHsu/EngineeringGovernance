{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-governance.local/schemas/contract-preflight.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "taskId", "projectRoot", "policyVersion", "policyDigest", "inputRawSha256", "inputSemanticDigest", "contractSemanticDigest", "repositoryBaselines", "checks", "planDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactType": { "const": "engineering-governance-contract-preflight-v1" },
    "taskId": { "type": "string", "minLength": 1 },
    "projectRoot": { "type": "string", "pattern": "^/" },
    "policyVersion": { "type": "string", "minLength": 1 },
    "policyDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "inputRawSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "inputSemanticDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "contractSemanticDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "repositoryBaselines": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "path", "head", "tree", "checkoutDigest"], "properties": { "id": { "type": "string", "minLength": 1 }, "path": { "type": "string", "pattern": "^/" }, "head": { "type": "string", "minLength": 1 }, "tree": { "type": "string", "minLength": 1 }, "checkoutDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } } },
    "checks": { "type": "array", "minItems": 10, "maxItems": 15, "items": { "type": "object", "additionalProperties": false, "required": ["id", "status", "evidenceRefs"], "properties": { "id": { "type": "string", "minLength": 1 }, "status": { "const": "PASS" }, "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } } } },
    "warnings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "selfReviewSubjectDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "planDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
