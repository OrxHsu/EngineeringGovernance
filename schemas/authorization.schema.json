{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-governance.local/schemas/authorization.schema.json",
  "$defs": {
    "legacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "authorizationId", "approvedBy", "issuedAt", "expiresAt", "scope", "status"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "authorizationId": { "type": "string", "minLength": 1 },
        "approvedBy": { "const": "user" },
        "issuedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$" },
        "expiresAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$" },
        "scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "status": { "const": "approved" }
      }
    },
    "hardened": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "artifactType", "authorizationId", "requirementId", "taskId", "contractDigest", "grantor", "action", "target", "scope", "issuedAt", "expiresAt", "status"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "artifactType": { "const": "sop-authorization-v2" },
        "authorizationId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "requirementId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "taskId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "contractDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "grantor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "role", "trustLevel"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "role": { "const": "user" },
            "trustLevel": { "enum": ["local-claim", "verified-attestation"] }
          }
        },
        "action": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "issuedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$" },
        "expiresAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$" },
        "status": { "const": "approved" },
        "attestation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "subject", "proof"],
          "properties": {
            "provider": { "type": "string", "minLength": 1 },
            "subject": { "type": "string", "minLength": 1 },
            "proof": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/legacy" },
    { "$ref": "#/$defs/hardened" }
  ]
}
