{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-governance.local/schemas/exception.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "exceptionId", "ruleId", "ruleClass", "reason", "scope", "approvedBy", "issuedAt", "expiresAt", "status", "compensatingControls"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "exceptionId": { "type": "string", "minLength": 1 },
    "ruleId": { "type": "string", "minLength": 1 },
    "ruleClass": { "enum": ["non_waivable", "user_authorization_required", "waiverable", "default"] },
    "reason": { "type": "string", "minLength": 1 },
    "scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "approvedBy": { "type": "string", "minLength": 1 },
    "issuedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$" },
    "expiresAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$" },
    "status": { "enum": ["active", "expired", "revoked"] },
    "compensatingControls": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
