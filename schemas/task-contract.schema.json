{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-governance.local/schemas/task-contract.schema.json",
  "$defs": {
    "risk": { "enum": ["R0", "R1", "R2", "R3"] },
    "evidenceKind": { "enum": ["static", "compile", "unit", "integration", "device", "cloud", "production"] },
    "legacyAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "observation", "positiveCases", "negativeCases"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "observation": { "type": "string", "minLength": 1 },
        "positiveCases": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "negativeCases": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryId", "cwd", "executable", "executableSha256", "arguments", "environment"],
      "properties": {
        "repositoryId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "cwd": { "type": "string", "minLength": 1 },
        "executable": { "type": "string", "pattern": "^/", "minLength": 2 },
        "executableSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "arguments": { "type": "array", "items": { "type": "string" } },
        "environment": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "observerPolicy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["expectedExitCode", "output", "expectedStdoutSha256", "expectedStderrSha256", "checkoutMutation", "replay"],
          "properties": {
            "expectedExitCode": { "type": "integer" },
            "output": { "const": "exact" },
            "expectedStdoutSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "expectedStderrSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "checkoutMutation": { "const": "forbidden" },
            "replay": { "enum": ["required", "not-required", "prohibited"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["expectedExitCode", "output", "checkoutMutation", "replay"],
          "properties": {
            "expectedExitCode": { "type": "integer" },
            "output": { "enum": ["nonempty", "exit-only"] },
            "checkoutMutation": { "const": "forbidden" },
            "replay": { "enum": ["required", "not-required", "prohibited"] }
          }
        }
      ]
    },
    "hardenedAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "observation", "positiveCases", "negativeCases", "evidenceKind", "command", "observerPolicy"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "observation": { "type": "string", "minLength": 1 },
        "positiveCases": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "negativeCases": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "evidenceKind": { "$ref": "#/$defs/evidenceKind" },
        "command": { "$ref": "#/$defs/command" },
        "observerPolicy": { "$ref": "#/$defs/observerPolicy" }
      }
    },
    "authorizationRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "target", "scope", "trustLevel", "consumeOnce"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "trustLevel": { "enum": ["recorded-claim", "verified-attestation"] },
        "consumeOnce": { "type": "boolean" }
      }
    },
    "legacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "taskId", "sopVersion", "contractDigest", "risk", "state", "implementationOwner", "objective", "scope", "nonGoals", "authorityInputs", "acceptance", "requiredGates", "openChoices"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "taskId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "sopVersion": { "type": "string", "minLength": 1 },
        "contractDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "risk": { "$ref": "#/$defs/risk" },
        "state": { "enum": ["DEFINED", "IN_PROGRESS", "CANDIDATE", "ACCEPTED", "CLOSED", "REPAIR_REQUIRED", "BLOCKED", "CANCELLED", "SUPERSEDED"] },
        "implementationOwner": { "type": "string", "minLength": 1 },
        "objective": { "type": "string", "minLength": 1 },
        "scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "nonGoals": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "authorityInputs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "acceptance": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/legacyAcceptance" } },
        "requiredGates": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "openChoices": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "hardened": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "taskId", "sopVersion", "policyDigest", "contractDigest", "risk", "riskSignals", "implementationOwner", "objective", "scope", "nonGoals", "authorityInputs", "repositories", "acceptance", "evidenceFreshnessMs", "authorizationRequirements", "extensions", "openChoices"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "taskId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "sopVersion": { "type": "string", "minLength": 1 },
        "policyDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "contractDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "risk": { "$ref": "#/$defs/risk" },
        "riskSignals": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "readOnly": { "type": "boolean" },
            "localEdit": { "type": "boolean" },
            "mutation": { "type": "boolean" },
            "classificationComplete": { "type": "boolean" },
            "userVisible": { "type": "boolean" },
            "crossModule": { "type": "boolean" },
            "multiRepository": { "type": "boolean" },
            "persistentData": { "type": "boolean" },
            "authentication": { "type": "boolean" },
            "authorization": { "type": "boolean" },
            "privacy": { "type": "boolean" },
            "security": { "type": "boolean" },
            "migration": { "type": "boolean" },
            "destructive": { "type": "boolean" },
            "payments": { "type": "boolean" },
            "production": { "type": "boolean" },
            "deployment": { "type": "boolean" },
            "remoteMutation": { "type": "boolean" },
            "externalCommunication": { "type": "boolean" },
            "restrictedRuntime": { "type": "boolean" },
            "projectMinimum": { "$ref": "#/$defs/risk" }
          }
        },
        "implementationOwner": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$" },
        "objective": { "type": "string", "minLength": 1 },
        "scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "nonGoals": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "authorityInputs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "repositories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path", "baseline"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
              "path": { "type": "string", "pattern": "^/", "minLength": 2 },
              "baseline": {
                "type": "object",
                "additionalProperties": false,
                "required": ["head", "tree", "checkoutDigest", "trackedPaths", "untrackedPaths"],
                "properties": {
                  "head": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
                  "tree": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
                  "checkoutDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                  "trackedPaths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                  "untrackedPaths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
                }
              }
            }
          }
        },
        "acceptance": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/hardenedAcceptance" } },
        "evidenceFreshnessMs": { "type": "integer", "minimum": 1, "maximum": 86400000 },
        "authorizationRequirements": { "type": "array", "items": { "$ref": "#/$defs/authorizationRequirement" } },
        "contractReadiness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "reviewPath", "gateVersion"],
          "properties": {
            "required": { "type": "boolean" },
            "reviewPath": { "type": "string", "pattern": "^\\.delivery/tasks/[a-z0-9][a-z0-9._-]*/contract-review\\.yaml$" },
            "gateVersion": { "type": "string", "minLength": 1 }
          }
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version", "digest", "input"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
              "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
              "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "input": { "type": "object" }
            }
          }
        },
        "openChoices": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/legacy" },
    { "$ref": "#/$defs/hardened" }
  ]
}
