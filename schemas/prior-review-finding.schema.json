{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-governance.local/schemas/prior-review-finding.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "recordId", "reviewedImplementation", "reporter", "decision", "acceptanceStatus", "finding", "reproduction", "recordedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactType": { "const": "engineering-governance-prior-review-finding-v1" },
    "recordId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "reviewedImplementation": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "commit", "tree"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "tree": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "reporter": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "trustLevel"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "trustLevel": { "const": "local-claim" } }
    },
    "decision": { "const": "REPAIR_REQUIRED" },
    "acceptanceStatus": { "const": "not-accepted" },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "severity", "classification", "observation", "requiredChange"],
      "properties": {
        "id": { "const": "P1" },
        "severity": { "const": "BLOCKER" },
        "classification": { "const": "newly_discovered_defect" },
        "observation": { "type": "string", "minLength": 1 },
        "requiredChange": { "type": "string", "minLength": 1 }
      }
    },
    "reproduction": {
      "type": "object", "additionalProperties": false,
      "required": ["input", "failure"],
      "properties": { "input": { "type": "string", "minLength": 1 }, "failure": { "type": "string", "minLength": 1 } }
    },
    "recordedAt": { "type": "string", "minLength": 1 }
  }
}
